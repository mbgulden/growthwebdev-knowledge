---
import shellData from "../../content/nav/aot-shell-data.json";
const { business, footerGroups } = shellData;
---
<footer role="contentinfo">
  <section class="aot-footer-contact" aria-label="Active Oahu Tours contact">
    <p><strong>{business.name}</strong></p>
    <p><a href={business.telephoneHref}>{business.phone}</a> · <a href={`mailto:${business.email}`}>{business.email}</a></p>
  </section>
  <nav class="aot-footer-nav" aria-label="Footer">
    {footerGroups.map((group) => (
      <section class:list={["footer-group", `priority-${group.priority}`]}>
        <h2>{group.heading}</h2>
        <ul>{group.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </section>
    ))}
  </nav>
</footer>
